# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 可选：透明 TCP/UDP 出口（仅 compose.egress.yml 使用，代理必须支持 UDP ASSOCIATE）
# ARTEX_EGRESS_SOCKS5=socks5://user:password@203.0.113.10:1080
# ARTEX_IMAGE=autumn27/artex:latest
# ARTEX_PUBLIC_PORT=8787
